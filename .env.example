# Copy this file to .env.local and fill in your own SANDBOX values.
# Get sandbox keys from https://developer.paypal.com
# (log in, then Apps & Credentials > Sandbox). Never commit .env.local,
# and never put live/production keys in this project — sandbox only.

# PayPal environment. This app only supports sandbox.
PAYPAL_ENV=sandbox

# Server-side only (used by the Orders API routes)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Browser-side (same sandbox client ID; used to load the PayPal buttons)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Optional: if set, the scheduling assistant will try an OpenAI-compatible
# LLM first and fall back to its built-in parser if the call fails.
# The app works end to end with no AI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
